@model Lab3.Models.Department

@{
    ViewData["Title"] = "Employees in " + Model.Name;
}

<h1>Employees in @Model.Name</h1>

<table class="table table-bordered">
    <thead>
        <tr><th>Id</th><th>Name</th><th>Age</th><th>Salary</th><th>Job Title</th></tr>
    </thead>
    <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Age</td>
                <td>@employee.Salary.ToString("N0")</td>
                <td>@employee.JobTitle</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to Departments</a>