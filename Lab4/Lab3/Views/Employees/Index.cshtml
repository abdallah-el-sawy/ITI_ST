@model IEnumerable<Lab3.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<p><a asp-action="Create" class="btn btn-primary">Add Employee</a></p>

<form method="get" asp-action="Index" class="d-flex mb-3" style="max-width: 400px;">
    <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control me-2" placeholder="Search by employee name..." />
    <button type="submit" class="btn btn-outline-primary">Search</button>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Salary</th>
            <th>Job Title</th>
            <th>Department</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Age</td>
                <td>@employee.Salary.ToString("N0")</td>
                <td>@employee.JobTitle</td>
                <td>@(employee.Department?.Name)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@employee.Id" method="post" style="display:inline;"
                          onsubmit="return confirm('Delete this employee?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>